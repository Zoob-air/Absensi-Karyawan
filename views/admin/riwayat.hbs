<!DOCTYPE html>
<html lang="id">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Riwayat Absensi Pekerja</title>

<link rel="stylesheet" href="/css/style.css">

<style>

.container{
    width:95%;
    margin:auto;
    padding:20px;
}

.card{
    background:white;
    padding:20px;
    border-radius:15px;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

table{
    width:100%;
    border-collapse:collapse;
}

th{
    background:#0d6efd;
    color:white;
    padding:12px;
}

td{
    padding:12px;
    border:1px solid #ddd;
}

.btn{
    background:#0d6efd;
    color:white;
    padding:10px 15px;
    text-decoration:none;
    border-radius:8px;
}

.filter{
    margin-bottom:20px;
}

.filter input{
    padding:10px;
}

.filter button{
    padding:10px 15px;
}
.foto-absen{
    width:70px;
    height:70px;
    object-fit:cover;
    border-radius:8px;
    border:1px solid #ddd;
}
.text-center{
    text-align:center;
}

</style>

</head>

<body>

<div class="container">

<h2>🕒 Riwayat Absensi Semua Pekerja</h2>

<div class="filter">

<form method="GET">

{{!-- <input
    type="month"
    name="bulan"
    value="{{bulan}}"
> --}}

{{!-- <button type="submit">
     Filter
</button> --}}

<a
    href="/admin/dashboard"
    class="btn"
>
    📊 Dashboard
</a>

</form>

</div>

<div class="card">
<form method="GET" action="/admin/riwayat" class="filter-form">

    <input
        type="month"
        name="bulan"
        value="{{bulan}}"
    >

    <input
        type="text"
        name="nama"
        placeholder="Cari nama"
        value="{{nama}}"
    >

    <input
        type="text"
        name="jabatan"
        placeholder="Cari jabatan"
        value="{{jabatan}}"
    >

    <button class="btn btn-primary" type="submit">
        Filter
    </button>

    <a href="/admin/riwayat" class="btn btn-secondary">
        Reset
    </a>

    <a
        href="/admin/riwayat/export/excel?bulan={{bulan}}&nama={{nama}}&jabatan={{jabatan}}"
        class="btn btn-success"
    >
        Export Excel
    </a>

    <a
        href="/admin/riwayat/export/pdf?bulan={{bulan}}&nama={{nama}}&jabatan={{jabatan}}"
        class="btn btn-danger"
    >
        Export PDF
    </a>

</form>
<table>

<thead>

<tr>

<th>NIK</th>
<th>Nama</th>
<th>Jabatan</th>
<th>Tanggal</th>
<th>Jam Masuk</th>
<th>Lokasi Masuk</th>
<th>Foto Masuk</th>
<th>Keterangan Masuk</th>
<th>Jam Keluar</th>
<th>Lokasi Keluar</th>
<th>Foto Keluar</th>
<th>Keterangan Keluar</th>

</tr>

</thead>

<tbody>

{{#if data.length}}

{{#each data}}

<tr>

<td>{{this.nik}}</td>
<td>{{this.nama}}</td>
<td>{{this.jabatan}}</td>
<td>{{this.tanggal}}</td>
<td>{{this.jam_masuk}}</td>
<td>{{this.lokasi_masuk}}</td>
<td class="text-center">
        {{#if this.foto_masuk}}
            <img 
                src="{{this.foto_masuk}}" 
                class="foto-absen" 
                alt="Foto Masuk"
            >
        {{else}}
            -
        {{/if}}
<td>{{this.keterangan_masuk}}</td>
<td>{{this.jam_keluar}}</td>
<td>{{this.lokasi_keluar}}</td>
<td class="text-center">
        {{#if this.foto_keluar}}
            <img 
                src="{{this.foto_keluar}}" 
                class="foto-absen" 
                alt="Foto Keluar"
            >
        {{else}}
            -
        {{/if}}
 </td>
<td>{{this.keterangan_keluar}}</td>

</tr>

{{/each}}

{{else}}

<tr>

<td colspan="12">
Belum ada data absensi
</td>

</tr>

{{/if}}

</tbody>

</table>

</div>

</div>

</body>
</html>