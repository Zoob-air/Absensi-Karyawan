<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Edit User</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container">

    <div class="card form-card">

        <h2>✏️ Edit User</h2>

        <form method="POST" action="/admin/users/edit/{{data.id}}">

            <div class="form-group">
                <label>NIK</label>
                <input type="text" name="nik" value="{{data.nik}}" required>
            </div>

            <div class="form-group">
                <label>Nama</label>
                <input type="text" name="nama" value="{{data.nama}}" required>
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="{{data.email}}" required>
            </div>

            <div class="form-group">
                <label>No HP</label>
                <input type="text" name="no_hp" value="{{data.no_hp}}">
            </div>

            <div class="form-group">
                <label>Jabatan</label>
                <input type="text" name="jabatan" value="{{data.jabatan}}">
            </div>

            <div class="form-group">
                <label>Role Login</label>
                <select name="role">
                    <option value="pekerja">Pekerja</option>
                    <option value="admin">Admin</option>
                </select>
            </div>

            <div class="form-group">
                <label>Status</label>
                <select name="status">
                    <option value="aktif">Aktif</option>
                    <option value="nonaktif">Nonaktif</option>
                </select>
            </div>

            <button class="btn btn-primary" type="submit">
                💾 Update
            </button>

            <a href="/admin/users" class="btn btn-secondary">
                ← Kembali
            </a>

        </form>

        <hr>

        <h3>🔐 Reset Password User</h3>

        <form method="POST" action="/admin/users/reset-password/{{data.id}}">
            <div class="form-group">
                <label>Password Baru</label>
                <input type="password" name="password_baru" placeholder="Default: 123456">
            </div>

            <button class="btn btn-danger" type="submit">
                Reset Password
            </button>
        </form>

    </div>

</div>

</body>
</html>