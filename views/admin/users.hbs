<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Pekerja</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .container{
            width:95%;
            margin:auto;
            padding:20px;
        }

        .header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:20px;
        }

        .btn{
            text-decoration:none;
            padding:10px 15px;
            border-radius:8px;
            color:white;
            font-weight:bold;
        }

        .btn-primary{
            background:#0d6efd;
        }

        .btn-success{
            background:#198754;
        }

        table{
            width:100%;
            border-collapse:collapse;
            background:white;
        }

        th{
            background:#0d6efd;
            color:white;
            padding:12px;
        }

        td{
            padding:12px;
            border-bottom:1px solid #ddd;
        }

        tr:hover{
            background:#f8f9fa;
        }

        .card{
            background:white;
            padding:20px;
            border-radius:15px;
            box-shadow:0 2px 10px rgba(0,0,0,.08);
        }

        .btn-danger{
            background:#dc3545;
        }

        .btn-danger:hover{
            background:#bb2d3b;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">

        <h2>Data Pekerja</h2>

        <div>

            <a href="/admin/dashboard" class="btn btn-primary">
                Dashboard
            </a>

            <a href="/admin/users/add" class="btn btn-success">
                Tambah Pekerja
            </a>

        </div>

    </div>

    <div class="card">

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>NIK</th>
                    <th>Nama</th>
                    <th>Email</th>
                    <th>No HP</th>
                    <th>Jabatan</th>
                    <th>Role</th>
                    <th>Aksi</th>
                </tr>

            </thead>

            <tbody>

            {{#each users}}

                <tr>

                    <td>{{this.id}}</td>

                    <td>{{this.nik}}</td>

                    <td>{{this.nama}}</td>

                    <td>{{this.email}}</td>

                    <td>{{this.no_hp}}</td>

                    <td>{{this.jabatan}}</td>

                    <td>{{this.role}}</td>
                    <td>
                        <a
                            href="/admin/users/delete/{{this.id}}"
                            class="btn btn-danger"
                            onclick="return confirm('Yakin ingin menghapus pekerja ini?')"
                        >
                            Hapus
                        </a>

                    </td>

                </tr>

            {{/each}}

            </tbody>

        </table>

    </div>

</div>

</body>
</html>