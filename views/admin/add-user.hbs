:root{
    --primary:#2563eb;
    --success:#16a34a;
    --danger:#dc2626;
    --warning:#f59e0b;
    --bg:#f4f7fb;
    --surface:#ffffff;
    --text:#0f172a;
    --muted:#64748b;
    --border:#e2e8f0;
    --shadow:0 18px 45px rgba(15,23,42,.10);
    --radius:18px;
}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:linear-gradient(135deg,#f8fbff 0%,#eef4ff 45%,#f7fbff 100%);color:var(--text);font-family:'Segoe UI',Arial,sans-serif}
a{color:inherit}.container{width:min(1180px,94%);margin:auto;padding:28px 0}.header,.card-header{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:22px}.header h1,.header h2,.card-header h2,h2,h3{margin-top:0;color:var(--text)}.header p,.card-header p{color:var(--muted);margin:.35rem 0 0}.menu,.btn-group,.filter form,.header>div:last-child{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.btn,button,.btn-login,.btn-clockin,.btn-clockout{border:0;border-radius:12px;padding:11px 16px;color:#fff!important;text-decoration:none;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 18px rgba(37,99,235,.20);transition:.2s ease}.btn:hover,button:hover,.btn-login:hover,.btn-clockin:hover,.btn-clockout:hover{transform:translateY(-1px);filter:brightness(.96)}.btn-primary,.btn-login{background:linear-gradient(135deg,var(--primary),#38bdf8)!important}.btn-success,.btn-clockin{background:linear-gradient(135deg,var(--success),#22c55e)!important}.btn-danger,.btn-clockout{background:linear-gradient(135deg,var(--danger),#fb7185)!important}.btn-secondary{background:linear-gradient(135deg,#64748b,#94a3b8)!important}.menu a:not(.btn){background:linear-gradient(135deg,var(--primary),#38bdf8);padding:12px 16px;border-radius:12px;text-decoration:none;color:#fff;font-weight:700;box-shadow:0 8px 25px rgba(15,23,42,.08)}
.card,.table-card,.status-card,.stat-card,.absen-card,.login-card{background:rgba(255,255,255,.92)!important;border:1px solid rgba(226,232,240,.9);border-radius:var(--radius)!important;box-shadow:var(--shadow)!important;backdrop-filter:blur(12px)}.card,.table-card,.status-card{padding:24px;overflow-x:auto}.stats-container{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px;margin:22px 0 30px}.stat-card{padding:24px;text-align:left;position:relative;overflow:hidden}.stat-card h3{font-size:14px;color:var(--muted);margin:0 0 10px;text-transform:uppercase;letter-spacing:.04em}.stat-card p{font-size:34px;font-weight:800;margin:0;color:var(--primary)}.hadir p{color:var(--success)!important}.belum p{color:var(--danger)!important}.persen p{color:var(--warning)!important}
table{width:100%;border-collapse:separate!important;border-spacing:0;background:#fff;border-radius:14px;overflow:hidden}th{background:linear-gradient(135deg,var(--primary),#38bdf8)!important;color:white;padding:14px 12px;text-align:center;font-size:13px;letter-spacing:.02em;white-space:nowrap}td{padding:13px 12px!important;border-bottom:1px solid var(--border)!important;color:#334155;vertical-align:middle}tbody tr:hover{background:#f8fafc!important}tbody tr:last-child td{border-bottom:0!important}.text-center{text-align:center}.empty-row,.empty{text-align:center;color:#777;padding:20px}
input,textarea,select{width:100%;padding:12px 14px;border:1px solid var(--border)!important;border-radius:12px!important;outline:none;font-size:14px;background:#fff;transition:.2s ease}input:focus,textarea:focus,select:focus{border-color:var(--primary)!important;box-shadow:0 0 0 4px rgba(37,99,235,.12)}label{display:block;margin-bottom:7px;font-weight:700;color:#334155}.form-group{margin-bottom:16px}.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}.form-card{max-width:650px;margin:40px auto}.filter-form{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:20px;align-items:center}.filter-form input{width:auto;min-width:180px}
.login-page{background:linear-gradient(120deg,rgba(15,23,42,.72),rgba(37,99,235,.45)),url('/images/fotopabrik.JPG');background-size:cover;background-position:center;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}.overlay{display:none}.login-container{width:100%;max-width:430px;position:relative;z-index:2}.login-card{width:100%!important;padding:36px!important}.logo{width:76px;height:76px;margin:0 auto 16px;border-radius:24px;background:linear-gradient(135deg,var(--primary),#38bdf8);color:#fff;display:flex;align-items:center;justify-content:center;font-size:34px;box-shadow:0 16px 30px rgba(37,99,235,.32)}.login-header{text-align:center;margin-bottom:26px}.login-header h2{margin:0 0 8px;font-size:25px}.login-header p{margin:0;color:var(--muted)}.input-group{height:54px;margin-bottom:16px;background:#f8fafc;border:1px solid var(--border);border-radius:14px;padding:0 14px;display:flex;align-items:center;gap:10px}.input-group i{color:var(--primary);min-width:18px}.input-group input{border:0!important;background:transparent;box-shadow:none!important}.alert-error{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;padding:12px;border-radius:12px;margin-bottom:16px;text-align:center;font-weight:700}.btn-login{width:100%;margin-top:15px}
.absen-container{min-height:100vh;display:flex;justify-content:center;align-items:center;padding:24px}.absen-card{width:100%;max-width:580px;overflow:hidden}.absen-header{background:linear-gradient(135deg,var(--primary),#38bdf8);color:#fff;text-align:center;padding:28px}.absen-header h2{color:#fff;margin:0}.absen-header p{margin:8px 0 0;opacity:.9}.datetime-box{text-align:center;padding:24px}.date{color:var(--muted);margin-bottom:8px}.time{font-size:42px;font-weight:900;color:var(--primary)}.absen-card form{padding:22px}hr{border:0;border-top:1px solid var(--border);margin:0}.btn-clockin,.btn-clockout{width:100%;padding:15px;font-size:16px}.status-text{font-size:26px;font-weight:900;color:var(--primary);margin-bottom:12px}.status-info p{margin:8px 0;color:#334155}
.floating-toast{position:fixed;top:24px;right:24px;z-index:9999;padding:16px 22px;border-radius:16px;color:#fff;font-weight:600;box-shadow:0 12px 30px rgba(0,0,0,0.18);animation:slideToast .4s ease,hideToast .5s ease 4s forwards}.floating-toast.success{background:linear-gradient(135deg,#16a34a,#22c55e)}.floating-toast.info{background:linear-gradient(135deg,#2563eb,#38bdf8)}.floating-toast.danger{background:linear-gradient(135deg,#dc2626,#f87171)}@keyframes slideToast{from{opacity:0;transform:translateX(60px)}to{opacity:1;transform:translateX(0)}}@keyframes hideToast{to{opacity:0;transform:translateX(60px);visibility:hidden}}button:disabled{opacity:.6;cursor:not-allowed}
@media(max-width:768px){.container{width:92%;padding:20px 0}.header,.card-header{align-items:flex-start;flex-direction:column}.row{grid-template-columns:1fr}.login-card{padding:28px!important}.time{font-size:34px}table{font-size:13px}.btn,button{width:auto}.menu{width:100%}.menu a{flex:1;text-align:center}.filter-form input{width:100%}}